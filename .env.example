# Copy to .env for local development:  cp .env.example .env
# Never commit .env. On Vercel, set these in Project → Settings → Environment Variables.
#
# With no .env at all, `go run ./cmd/server` still works: development mode uses
# an in-memory store and the "log" email provider.

# ── Runtime ──────────────────────────────────────────────────────────────────
# development | production. Defaults to production on Vercel (VERCEL=1).
APP_ENV=development
PORT=6162
# LOG_LEVEL=debug

# ── Email provider selection ─────────────────────────────────────────────────
# brevo | ses | log   (log = render and print only; development default)
EMAIL_PROVIDER=log
# Emails show the prospect as sender name: "Jane Doe (jane@acme.com)" <verified from address>.
# This name is only a fallback when the prospect's email can't be parsed.
EMAIL_FROM_NAME=Website Quote Requests
EMAIL_SEND_TIMEOUT_SECONDS=8

# Inbox that receives new-lead notifications (e.g. IONOS mailbox forwarding to Outlook)
SALES_NOTIFICATION_EMAIL=quote@yourdomain.com

# ── Brevo REST API (EMAIL_PROVIDER=brevo) ────────────────────────────────────
# API key from Settings → SMTP & API → API Keys (starts with xkeysib-).
# The old BREVO_SMTP_* variables are no longer used.
BREVO_API_KEY=
# Must be on a domain authenticated in Brevo (DKIM/DMARC)
BREVO_FROM_EMAIL=website-notifications@yourdomain.com

# ── AWS SES v2 (EMAIL_PROVIDER=ses) ──────────────────────────────────────────
# Vercel reserves AWS_REGION / AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, so use
# the SES_-prefixed names there. Elsewhere the standard AWS_* chain also works.
SES_AWS_REGION=us-east-1
SES_AWS_ACCESS_KEY_ID=
SES_AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=website-notifications@yourdomain.com
# Optional: publish delivery/bounce events via a configuration set
# SES_CONFIGURATION_SET=website-notifications

# ── Database (Neon Postgres) ─────────────────────────────────────────────────
# Leave empty in development to use the in-memory store.
# Runtime: pooled connection string (host contains "-pooler").
DATABASE_URL=
# Migrations: direct connection (the Neon ↔ Vercel integration sets this).
DATABASE_URL_UNPOOLED=
DB_MAX_CONNS=4

# ── Security ─────────────────────────────────────────────────────────────────
# Origins allowed to POST forms (comma-separated). The request's own host is
# always allowed, so Vercel preview URLs work without listing them.
ALLOWED_ORIGIN=https://yourdomain.com,https://www.yourdomain.com
# Secret for HMAC-hashing client IPs (min 16 chars). Generate: openssl rand -hex 32
IP_HASH_SALT=
QUOTE_RATE_LIMIT_PER_HOUR=5
# Trust X-Real-IP / X-Forwarded-For. Automatically true on Vercel; set true only
# behind a proxy that overwrites these headers.
# TRUST_PROXY_HEADERS=false

# ── Optional ─────────────────────────────────────────────────────────────────
# External tracking portal; {ref} is replaced with the tracking number.
# TRACKING_URL=https://track.yourdomain.com/shipments/{ref}
